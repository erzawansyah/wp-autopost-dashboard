{
  "$description": "Konfigurasi parameter default dan batas eksekusi Writer Agents Panitera",
  "standardLimits": {
    "maxModelCalls": 12,
    "maxToolCalls": 15,
    "timeoutSeconds": 240,
    "minWordCount": 600,
    "perTool": {
      "web_search": 6,
      "web_reader": 6,
      "image_search": 4,
      "upload_media": 4,
      "set_featured_image": 2,
      "keyword_suggestions": 4
    }
  },
  "deepLimits": {
    "maxModelCalls": 22,
    "maxToolCalls": 28,
    "timeoutSeconds": 360,
    "minWordCount": 800,
    "perTool": {
      "web_search": 8,
      "web_reader": 9,
      "image_search": 5,
      "upload_media": 5,
      "set_featured_image": 3,
      "keyword_suggestions": 6
    }
  },
  "systemBounds": {
    "minModelCalls": 3,
    "maxModelCalls": 35,
    "minToolCalls": 0,
    "maxToolCalls": 50,
    "minTimeoutSeconds": 30,
    "maxTimeoutSeconds": 480,
    "minWordCount": 300,
    "maxWordCount": 5000,
    "defaultPerToolLimit": 10
  },
  "ai": {
    "$description": "Default gateway LLM per run (src/core/shared/llm/gateway.ts): model cadangan, retry transien, dan parameter panggilan. Setiap nilai di-clamp ke ai.bounds.",
    "fallbackModels": ["openai/gpt-4o-mini", "meta-llama/llama-3.3-70b-instruct"],
    "maxRetries": 2,
    "agentTemperature": 0.95,
    "agentMaxTokens": 16384,
    "jsonTemperature": 0.4,
    "jsonTimeoutSeconds": 35,
    "finalizeTimeoutSeconds": 120,
    "bounds": {
      "maxFallbackModels": 3,
      "maxRetries": 4,
      "minTemperature": 0,
      "maxTemperature": 2,
      "minMaxTokens": 1024,
      "maxMaxTokens": 32768,
      "minTimeoutSeconds": 5,
      "maxTimeoutSeconds": 300
    }
  }
}
