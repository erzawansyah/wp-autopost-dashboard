{
  "secret-leak-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/verify-no-secrets.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
