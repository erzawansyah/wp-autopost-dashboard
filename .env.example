# ==============================================================================
# 1. SUPABASE (DATABASE & MULTI-TENANT AUTH)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Supabase New Standard (atau gunakan NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Kunci Server-Side (Worker / Cron / Admin Action) — format baru SUPABASE_SECRET_KEY atau legacy SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_ACCESS_TOKEN="sbp_your-personal-access-token-for-mcp"

# ==============================================================================
# 2. SECURITY & ENCRYPTION (MULTI-SITE WP CREDENTIALS)
# ==============================================================================
# 32-byte hex key (64 karakter hex) untuk mengenkripsi WordPress Application Password (AES-256-GCM)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""

# Token rahasia untuk memverifikasi pemicu Cron / Webhook antrean
CRON_SECRET=""
WEBHOOK_SIGNATURE_SECRET=""

# ==============================================================================
# 3. AI & CONTENT GENERATION PROVIDERS (OPENROUTER-FIRST + EXTENSIBLE BYOK)
# ==============================================================================
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="WP Autopost Dashboard"

# Optional fallback / direct providers (selain BYOK yang disimpan per-user di DB)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# ==============================================================================
# 4. SEO & MEDIA MCP / API INTEGRATIONS (OPTIONAL / AGENT OPS)
# ==============================================================================
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
PEXELS_API_KEY=""
