# ==============================================================================
# PANITERA — ENVIRONMENT CONFIGURATION
# ==============================================================================
# CATATAN BYOK (Bring Your Own Key):
# Kunci API AI (OpenRouter) dan Mesin Pencari/Foto (Tavily, Brave, SerpAPI,
# Pexafy, LangSmith) TIDAK diisi di file ini. Setiap pengguna/tenant memasukkan
# kuncinya sendiri di dashboard (Pengaturan ➔ Kunci API, /settings/keys); kunci
# disimpan terenkripsi AES-256-GCM di database Supabase dan hanya dipakai untuk
# tenant pemiliknya.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (DATABASE & MULTI-TENANT AUTH)
# ------------------------------------------------------------------------------
# URL project Supabase Anda (misal: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable Key / Anon Key (untuk autentikasi sisi klien browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Atau jika menggunakan format lama anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Supabase Secret Key / Service Role Key (wajib untuk background worker & cron bypass RLS)
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ------------------------------------------------------------------------------
# 2. KEAMANAN & KRIPTOGRAFI (WAJIB)
# ------------------------------------------------------------------------------
# Kunci master 32-byte hex (64 karakter) untuk enkripsi password WP & kunci API user (AES-256-GCM)
# Generate baru via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""

# WAJIB. Token rahasia pemicu cron worker (/api/queue/process).
# Hanya diterima lewat header `Authorization: Bearer <token>` atau `x-cron-secret`,
# tidak lewat query string. Jika kosong, semua panggilan cron ditolak (401).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Batas maksimal artikel yang diproses per siklus cron worker (default: 5)
QUEUE_CRON_LIMIT="5"

# ------------------------------------------------------------------------------
# 3. PLATFORM & SEARXNG
# ------------------------------------------------------------------------------
# URL publik dashboard (dipakai untuk callback koneksi WordPress & metadata OpenRouter)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Panitera"
OPENROUTER_SITE_URL="http://localhost:3000"

# URL instance internal SearXNG (otomatis terhubung di Docker network).
# Hanya endpoint /search & /autocompleter di origin ini yang boleh diakses server.
SEARXNG_URL="http://searxng-internal:8080"
# WAJIB untuk docker-compose. Generate: openssl rand -hex 32
SEARXNG_SECRET=""

# Port host untuk akses web dashboard (default: 3000)
HOST_PORT="3000"

# ------------------------------------------------------------------------------
# 4. KUNCI PLATFORM (OPSIONAL, DEFAULT MATI)
# ------------------------------------------------------------------------------
# Secara default Panitera BYOK-only: tenant tanpa kunci sendiri mendapat pesan
# untuk mengisi /settings/keys. Set "true" hanya jika operator sengaja ingin
# menanggung biaya pemakaian tenant memakai kunci di bawah ini.
PLATFORM_KEY_ALLOWED="false"
# OPENROUTER_API_KEY=""
# PEXAFY_API_KEY=""

# ------------------------------------------------------------------------------
# 5. PENGEMBANGAN LOKAL (JANGAN DIPAKAI DI PRODUCTION)
# ------------------------------------------------------------------------------
# Izinkan server mengakses alamat jaringan privat/localhost (misal WordPress
# Playground di localhost:8881). Selalu diabaikan saat NODE_ENV=production.
# ALLOW_PRIVATE_NETWORK_FETCH="true"
