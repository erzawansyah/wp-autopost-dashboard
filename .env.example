# ==============================================================================
# PANITERA — ENVIRONMENT CONFIGURATION
# ==============================================================================
# CATATAN BYOK (Bring Your Own Key):
# Kunci API AI (OpenRouter) dan Mesin Pencari/Foto (Tavily, Brave, Pexafy)
# TIDAK PERLU dimasukkan di file ini!
# Setiap pengguna/tenant memasukkan API Key mereka masing-masing langsung di
# dashboard web (menu Pengaturan ➔ Kunci API /settings/keys) yang disimpan
# secara aman dan terenkripsi AES-256-GCM di database Supabase.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (DATABASE & MULTI-TENANT AUTH)
# ------------------------------------------------------------------------------
# URL project Supabase Anda (misal: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable Key / Anon Key (untuk autentikasi sisi klien browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Atau jika menggunakan format lama anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Supabase Secret Key / Service Role Key (wajib untuk background worker & cron bypass RLS)
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ------------------------------------------------------------------------------
# 2. KEAMANAN & KRIPTOGRAFI (WAJIB)
# ------------------------------------------------------------------------------
# Kunci master 32-byte hex (64 karakter) untuk enkripsi password WP & kunci API user (AES-256-GCM)
# Generate baru via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""

# Token rahasia pengaman pemicu cron worker internal (/api/queue/process)
CRON_SECRET=""

# Batas maksimal artikel yang diproses per menit oleh cron worker (default: 5)
QUEUE_CRON_LIMIT="5"

# Token rahasia opsional untuk menandatangani payload webhook keluar (HMAC-SHA256)
WEBHOOK_SIGNATURE_SECRET=""

# ------------------------------------------------------------------------------
# 3. PENGATURAN PLATFORM & SEARXNG (OPSIONAL / DEFAULT DOCKER)
# ------------------------------------------------------------------------------
# Nama aplikasi & URL publik platform Anda (dipakai untuk metadata OpenRouter & auth redirect)
OPENROUTER_APP_NAME="Panitera"
OPENROUTER_SITE_URL="http://localhost:3000"

# URL instance internal SearXNG (otomatis terhubung di Docker network)
SEARXNG_URL="http://searxng-internal:8080"
SEARXNG_SECRET="panitera-searxng-internal-key"

# Port host untuk akses web dashboard (default: 3000)
HOST_PORT="3000"
